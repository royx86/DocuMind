# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:change-this-password@localhost:5432/qna_db

# Security & JWT
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# File Storage
UPLOAD_DIR=./uploads

# Use either a JSON array or comma-separated origins. Add the deployed frontend
# origin exactly as shown in the browser address bar, without a path.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional AI API Key (Groq, Gemini, or OpenAI)
# If left blank, DocuMind operates with its built-in smart offline RAG and quiz engine.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_API_KEY=
