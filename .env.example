# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=qna_db
DATABASE_URL=postgresql+asyncpg://postgres:change-this-password@localhost:5432/qna_db

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars

# File Storage
UPLOAD_DIR=./backend/uploads

# AI Providers (Optional - DocuMind operates offline with smart extractive RAG if omitted)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
OPENAI_API_KEY=

# JSON array of frontend origins allowed to call the API
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080"]
